varnishtest "Test VCL temperature and discard."

server s1 {
   rxreq
   txresp
} -repeat 1 -start

varnish v1 -vcl+backend {
    import ${vmod_redis};

    sub vcl_init {
        redis.weights(
            rules={""});

        redis.sentinels(
            locations={""},
            period=0,
            connection_timeout=500,
            command_timeout=0);

        new db1 = redis.db(
            location="${redis_master1_ip}:${redis_master1_port}",
            type=master,
            connection_timeout=500,
            connection_ttl=0,
            command_timeout=0,
            max_command_retries=0,
            shared_connections=false,
            max_connections=1,
            protocol=${redis_protocol},
            tls=${redis_tls},
            tls_cafile="${redis_tls_cafile}",
            tls_certfile="${redis_tls_certfile}",
            tls_keyfile="${redis_tls_keyfile}",
            password="",
            sickness_ttl=0,
            ignore_slaves=false,
            max_cluster_hops=0);

        new db2 = redis.db(
            location="${redis_master2_ip}:${redis_master2_port}",
            type=master,
            connection_timeout=500,
            connection_ttl=0,
            command_timeout=0,
            max_command_retries=0,
            shared_connections=true,
            max_connections=32,
            protocol=${redis_protocol},
            tls=${redis_tls},
            tls_cafile="${redis_tls_cafile}",
            tls_certfile="${redis_tls_certfile}",
            tls_keyfile="${redis_tls_keyfile}",
            password="",
            sickness_ttl=0,
            ignore_slaves=false,
            max_cluster_hops=0);
    }
} -start

varnish v1 -vcl+backend {
}

varnish v1 -cliok "vcl.state vcl1 cold"

varnish v1 -cliok "vcl.state vcl1 warm"

varnish v1 -cliok "vcl.use vcl1"

varnish v1 -cliok "vcl.use vcl2"

varnish v1 -cliok "vcl.discard vcl1"

varnish v1 -expect MGT.child_panic == 0
